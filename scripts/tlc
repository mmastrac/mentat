#!/bin/sh
# Run the TLC model checker from a pinned tla2tools.jar. The jar is fetched
# once into the cache and checked against its sha256 on every run.
#
#   scripts/tlc -config spec/HeadDaemon.cfg spec/HeadDaemon.tla
#
# JAVA overrides the Java runtime.
set -eu

VERSION=1.7.4
SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
cache=${XDG_CACHE_HOME:-$HOME/.cache}/mentat
jar=$cache/tla2tools-$VERSION.jar

if [ ! -f "$jar" ]; then
    mkdir -p "$cache"
    curl -fsSL -o "$jar.tmp" \
        "https://github.com/tlaplus/tlaplus/releases/download/v$VERSION/tla2tools.jar"
    mv "$jar.tmp" "$jar"
fi

if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$jar" | cut -d' ' -f1)
else
    got=$(shasum -a 256 "$jar" | cut -d' ' -f1)
fi
if [ "$got" != "$SHA256" ]; then
    echo "tlc: $jar has sha256 $got, expected $SHA256" >&2
    rm -f "$jar"
    exit 1
fi

# macOS puts a `java` stub on PATH that fails without a JDK, and Homebrew's
# openjdk is keg-only, so a working java may sit outside PATH.
java=${JAVA:-}
if [ -z "$java" ]; then
    for candidate in java /opt/homebrew/opt/openjdk/bin/java /usr/local/opt/openjdk/bin/java; do
        if "$candidate" -version >/dev/null 2>&1; then
            java=$candidate
            break
        fi
    done
fi
if [ -z "$java" ]; then
    echo "tlc: no Java runtime. Install a JDK or set JAVA." >&2
    exit 1
fi

exec "$java" -XX:+UseParallelGC -cp "$jar" tlc2.TLC "$@"
