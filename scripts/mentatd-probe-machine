#!/bin/sh
# Prints one JSON object on stdout: the machine an agent registers with.
# Integers only. mentatd exits when this script fails or its output does not
# parse, so the fallbacks below give a figure rather than an error.
#
# MENTAT_GPUS is the only override read here. MENTAT_MACHINE replaces the
# whole object and mentatd reads it instead.
set -eu

# Product names whose device addresses the system pool rather than board
# memory of its own. GB10 is the DGX Spark. The match is a substring, so add
# a part here when one ships.
UMA_NAMES="GB10"

system_memory() {
    if [ -r /proc/meminfo ]; then
        awk '/^MemTotal:/ { print $2 * 1024; found = 1 }
             END { if (!found) print 0 }' /proc/meminfo
        return
    fi
    # macOS, which has no /proc.
    if sysctl -n hw.memsize 2>/dev/null; then
        return
    fi
    echo 0
}

cpu_count() {
    n=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
    [ "$n" -gt 0 ] 2>/dev/null || n=1
    echo "$n"
}

MEM=$(system_memory)
CPUS=$(cpu_count)

# Placeholder devices for a box with no GPU. A node whose agent registers
# none cannot host a bundle rank.
fake_gpus() {
    awk -v n="$1" 'BEGIN {
        sep = ""
        for (i = 0; i < n; i++) {
            printf "%s{\"index\":%d,\"vendor\":\"nvidia\",\"name\":\"fake\",", sep, i
            printf "\"memory\":0,\"uma\":false}"
            sep = ","
        }
    }'
}

# index, name, and memory.total in MiB, or `[N/A]` on a part with no board
# memory of its own. nounits keeps the unit off the figure so awk gets a
# number.
nvidia_gpus() {
    nvidia-smi --query-gpu=index,name,memory.total \
               --format=csv,noheader,nounits 2>/dev/null |
    awk -F', *' -v pool="$MEM" -v uma_names="$UMA_NAMES" '
        function json_escape(s) {
            gsub(/\\/, "\\\\", s)
            gsub(/"/, "\\\"", s)
            return s
        }
        NF >= 3 && $1 ~ /^[0-9]+$/ {
            name = $2
            total = $3
            uma = 0
            split(uma_names, u, " ")
            for (i in u) if (index(name, u[i]) > 0) uma = 1
            if (total !~ /^[0-9]+$/) uma = 1
            mem = uma ? pool : total * 1024 * 1024
            printf "%s{\"index\":%d,\"vendor\":\"nvidia\",\"name\":\"%s\",", sep, $1, json_escape(name)
            printf "\"memory\":%d,\"uma\":%s}", mem, uma ? "true" : "false"
            sep = ","
        }
    '
}

if [ -n "${MENTAT_GPUS:-}" ]; then
    GPUS=$(fake_gpus "$MENTAT_GPUS")
else
    GPUS=$(nvidia_gpus)
fi

printf '{"memory":%s,"cpus":%s,"gpus":[%s]}\n' "$MEM" "$CPUS" "$GPUS"
